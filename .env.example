# === LLM ===
GROQ_API_KEY=your_groq_api_key_here

# === Vector Database (Zilliz Cloud) ===
ZILLIZ_URI=https://your-cluster.zillizcloud.com
ZILLIZ_TOKEN=your_zilliz_api_token_here
ZILLIZ_COLLECTION_NAME=customer_support_kb

# === PostgreSQL (Neon or local) ===
POSTGRES_HOST=your-host.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=neondb
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=your_neon_password_here
POSTGRES_SSL=true

# === App ===
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# === Embeddings ===
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# === Chunking ===
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# === LLM Model ===
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=1024
